# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/jobpilot

# Authentication
JWT_SECRET=jobpilot_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Integration (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Cloudinary (File and Report Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer / Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="JobPilot AI" <noreply@jobpilot.ai>

# Default Application Rules
DEFAULT_MATCH_SCORE=80
DEFAULT_DAILY_APPLICATION_LIMIT=10
DEFAULT_POSTING_AGE_DAYS=7

# Agent Configuration
AGENT_TIMEZONE=Asia/Kolkata
HEADLESS_BROWSER=true
BROWSER_TIMEOUT_MS=30000

